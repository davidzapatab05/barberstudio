---
import content from '../data/content.json';
import { Button } from './ui/button';
---

<nav class="absolute top-0 left-0 w-full z-50 border-b border-[#1a1a1a] bg-black/50 backdrop-blur-md">
  <div class="container mx-auto px-6 h-24 flex items-center justify-between">
    
    {/* Logo */}
    <div class="flex flex-col">
      <a href="#" class="font-display text-2xl tracking-widest text-white uppercase">
        {content.brand.name}
      </a>
      <span class="font-sans text-xs text-primary tracking-widest uppercase">
        {content.brand.owner}
      </span>
    </div>

    {/* Links (Desktop) */}
    <div class="hidden md:flex items-center gap-8">
      {content.navbar.links.map(link => (
        <a href={link.href} class="font-sans text-xs font-medium tracking-[0.2em] text-muted-foreground hover:text-white uppercase transition-colors">
          {link.name}
        </a>
      ))}
    </div>


    
  </div>
</nav>
