---
import content from '../data/content.json';
import { Button } from './ui/button';

const whatsappUrl = `https://wa.me/${content.brand.whatsapp.number.replace('+', '')}?text=${encodeURIComponent(content.brand.whatsapp.message)}`;
---

<section class="bg-background">
  <div class="relative h-[60vh] min-h-[500px] flex items-end overflow-hidden">
    <img src={content.location.image} alt="Barber Studio" class="absolute inset-0 w-full h-full object-cover grayscale opacity-40 scale-105" />
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent"></div>
    
    <div class="relative z-10 p-8 md:p-16 w-full max-w-[1440px] mx-auto flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
      <div>
        <h3 class="text-4xl md:text-5xl font-display font-bold mb-4 text-white">{content.location.title}</h3>
        <p class="font-sans text-lg text-gray-300 mb-2">{content.location.address}</p>
        <p class="font-sans text-lg text-gray-400">{content.location.schedule}</p>
      </div>
      <a href={content.location.mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-sans font-medium tracking-[0.2em] text-white hover:text-primary transition-colors border-b border-white/30 hover:border-primary pb-2">
        CÓMO LLEGAR <span>&nearr;</span>
      </a>
    </div>
  </div>

  <div class="relative bg-[#020202] py-40 px-6 overflow-hidden">
    <!-- Glow de fondo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/20 blur-[150px] rounded-full pointer-events-none"></div>

    <div class="relative z-10 container mx-auto flex flex-col items-center text-center">
      <h2 class="text-6xl md:text-[8rem] lg:text-[10rem] font-display font-extrabold leading-[0.9] tracking-tight mb-20 text-white drop-shadow-2xl">
        {content.location.cta.split('\n').map((line, i) => (
          <span class={`block ${i === 1 ? 'text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400' : ''}`}>{line}</span>
        ))}
      </h2>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        <Button size="lg" className="rounded-full text-xl md:text-2xl px-12 py-8 md:py-10 uppercase tracking-widest bg-white text-black hover:bg-primary hover:text-white transition-all duration-500 shadow-[0_0_40px_rgba(255,255,255,0.1)] hover:shadow-[0_0_60px_rgba(0,68,255,0.5)] hover:scale-105">
          {content.location.ctaButton}
        </Button>
      </a>
    </div>
  </div>
</section>
