---
import content from '../data/content.json';
import { Separator } from './ui/separator';
---

<section class="bg-card py-24 px-6 md:px-12 border-y border-border/50">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      
      <div>
        <h2 class="text-5xl md:text-7xl font-display leading-[0.9] text-foreground">
          {content.experience.title.split('\n').map(line => (
            <span class="block">{line}</span>
          ))}
        </h2>
      </div>
      
      <div class="flex flex-col gap-12">
        {content.experience.steps.map((step, index) => (
          <div>
            <div class="flex items-center gap-6 pb-8">
              <span class="font-display text-4xl text-primary">{step.id}</span>
              <p class="text-xl text-muted-foreground">{step.text}</p>
            </div>
            {index < content.experience.steps.length - 1 && (
              <Separator className="bg-border" />
            )}
          </div>
        ))}
      </div>
      
    </div>
  </div>
</section>
