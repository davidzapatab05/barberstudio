---
import content from '../data/content.json';
---

<section class="bg-background flex items-center justify-center text-center min-h-[50vh] py-24 px-6">
  <div class="container mx-auto w-full max-w-4xl relative py-12">
    <div class="tech-line"></div>
    
    <h2 class="text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] leading-[1.1] my-20 font-display font-extrabold tracking-tight">
      <span class="block text-muted-foreground">{content.statement.text1}</span>
      <span class="block text-white mt-4">{content.statement.text2}</span>
    </h2>
    
    <div class="tech-line"></div>
  </div>
</section>
