---
import content from '../data/content.json';
import { QuoteIcon as Quote } from './Icons';
---

<section class="bg-black py-24 md:py-32">
  <div class="container mx-auto px-6">
    
    <div class="text-center mb-16">
      <p class="font-sans text-xs tracking-[0.2em] text-primary uppercase mb-4">{content.testimonials.section_subtitle}</p>
      <h2 class="font-display text-4xl md:text-5xl text-white">{content.testimonials.title}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {content.testimonials.items.map((item: any) => (
        <div class="bg-[#050505] border border-[#1a1a1a] p-8 md:p-10 flex flex-col justify-between group hover:border-primary/50 transition-colors duration-500">
          <div>
            <div class="text-primary mb-6 opacity-50">
              <Quote size={32} />
            </div>
            <p class="font-sans text-sm md:text-base text-muted-foreground font-light leading-relaxed mb-8 italic">
              "{item.text}"
            </p>
          </div>
          
          <div class="flex items-center gap-4 mt-auto">
            <div class="w-12 h-12 rounded-full overflow-hidden border border-[#1a1a1a]">
              {/* Fallback initials using Dicebear API */}
              <img src={`https://api.dicebear.com/7.x/initials/svg?seed=${item.author}&backgroundColor=000000&textColor=ffffff`} alt={item.author} width="48" height="48" class="w-full h-full object-cover" />
            </div>
            <span class="font-sans text-sm text-muted-foreground font-medium">- {item.author}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
