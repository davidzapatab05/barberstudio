---
import content from '../data/content.json';
import TransformationSlider from './TransformationSlider';
---

<section class="bg-black py-24 px-6 md:px-12">
  <div class="container mx-auto">
    <div class="text-center mb-16">
      <p class="font-sans text-xs tracking-[0.2em] text-primary uppercase mb-4">RESULTADOS</p>
      <h2 class="font-display text-4xl md:text-5xl text-white">Resultados Impecables</h2>
    </div>

    <div class="max-w-4xl mx-auto">
      <TransformationSlider 
        client:load 
        beforeImage={content.transformation.beforeImage} 
        afterImage={content.transformation.afterImage} 
      />
    </div>
  </div>
</section>
