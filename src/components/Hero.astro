---
import content from '../data/content.json';
import { Button } from './ui/button';
import { InstagramIcon, TikTokIcon, MessageCircleIcon } from './Icons';

const whatsappUrl = `https://wa.me/${content.brand.whatsapp.number.replace('+', '')}?text=${encodeURIComponent(content.brand.whatsapp.message)}`;
---

<section class="relative w-full h-screen min-h-[700px] flex items-center bg-black pt-24 pb-12">
  
  {/* Imagen de fondo (Derecha) */}
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div class="absolute inset-y-0 right-0 w-full md:w-[70%] h-full">
      <img src={content.hero.image} alt="Barber Studio" fetchpriority="high" loading="eager" class="w-full h-full object-cover grayscale opacity-60" />
      {/* Gradiente para fundir con el negro hacia la izquierda */}
      <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30"></div>
    </div>
  </div>

  {/* Contenido (Izquierda) */}
  <div class="container relative z-10 mx-auto px-6 md:px-12 flex flex-col justify-center h-full">
    <div class="max-w-3xl">
      
      {/* Tagline */}
      <div class="font-sans text-xs md:text-sm font-semibold tracking-[0.3em] text-primary mb-6 uppercase">
        {content.hero.tagline}
      </div>
      
      {/* Título Principal */}
      <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-[7rem] font-display font-medium leading-[1.1] mb-8 text-white">
        {content.hero.title_normal} <br />
        <span class="text-primary italic font-light">{content.hero.title_highlight}</span>
      </h1>
      
      {/* Subtítulo */}
      <p class="font-sans text-lg md:text-xl text-muted-foreground mb-12 max-w-lg font-light leading-relaxed">
        {content.hero.subtitle.split('\n').map((line: string) => (
          <span class="block">{line}</span>
        ))}
      </p>
      
      {/* Botones y Redes */}
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <Button className="rounded-md bg-primary text-white hover:bg-white hover:text-black font-sans text-sm tracking-widest uppercase h-14 px-10 transition-all duration-300 shadow-[0_0_30px_rgba(0,85,255,0.4)]">
            {content.hero.cta} &rarr;
          </Button>
        </a>
        
        <div class="flex items-center gap-5">
          <a href={content.footer.social.instagram_url} target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="Instagram">
            <InstagramIcon size={24} />
          </a>
          <a href={content.footer.social.tiktok_url} target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="TikTok">
            <TikTokIcon size={24} />
          </a>
          <a href={whatsappUrl} target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label="WhatsApp">
            <MessageCircleIcon size={24} />
          </a>
        </div>
      </div>
      
    </div>
  </div>
  
  {/* Divisor inferior elegante (Línea horizontal) */}
  <div class="absolute bottom-0 left-0 w-full flex justify-center z-20">
    <div class="w-full h-[1px] bg-primary/30"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 bg-black px-6 font-display text-primary italic text-xl tracking-widest">
      GM
    </div>
  </div>
</section>
